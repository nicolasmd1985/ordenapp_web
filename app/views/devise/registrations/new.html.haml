.container
  .row
    .col-sm-8.col-md-6.col-lg-6
      .card.light-1.p-0.background_video
        = video_tag "https://#{ENV['S3_BUCKET_NAME'] || Rails.application.credentials[:aws][:S3_BUCKET_NAME]}.s3.amazonaws.com/ordenapp_main_page_light.mp4", playsinline: true, controls: false, autoplay: true, width: "100%", id: "video_presentation", preload: "auto", muted: true, loop: false

    .col-sm-8.col-md-6.col-lg-6
      .card.light-1.p-0
        %h3.card-header.info-color.white-text.text-center.py-4.mb-3
          = t("session.index.sign_up")
        .card-body.px-lg-5.text-center
          = link_to user_google_oauth2_omniauth_authorize_path, class: "btn btn-primary", style: "background-color: #dd4b39 !important" do
            %i.fab.fa-google
          %br
          %br
          = t("session.index.or")
          %button.btn.btn-primary#email_register{type: "button"}
            = t("session.index.email_register")

          #form_new_email
            = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { autocomplete: "off", id: "signup_form" }) do |f|
              = render "devise/shared/error_messages", resource: resource
              = f.hidden_field :honeypot, value: '', class: 'd-none'
              = recaptcha_v3(action: 'signup')

              .row
                .col-6
                  .form__field--input.md-form.field#verify_name.validate_field
                    = f.label :first_name, t("users.index.name"), {"data-error" => "wrong", "data-success" => "right"}
                    = f.text_field :first_name, autofocus: true, required: true, minlength: 3, class: "form-control validate", id: "autocomplete-name", autocomplete: "given-name", style: "margin-bottom: 0.5rem;"
                    .invalid-feedback
                      = t("base.forms.err_2")
                .col-6
                  .form__field--input.md-form.field#verify_lastname.validate_field
                    = f.label :last_name, t("users.index.last_name"), {"data-error" => "wrong", "data-success" => "right"}
                    = f.text_field :last_name, required: true, minlength: 3, class: "form-control validate", id: "autocomplete-lastname", autocomplete: "family-name", style: "margin-bottom: 0.5rem;"
                    .invalid-feedback
                      = t("base.forms.err_2")

              .form__field--input.md-form
                = f.label :phone_number_1, t("users.index.phone_1")
                = f.telephone_field :phone_number_1, maxlength: 20, class: "form-control", id: "autocomplete-phone_number_1", autocomplete: "tel", style: "margin-bottom: 0.5rem;", pattern: "[0-9]{10,20}"
                .invalid-feedback
                  = t("profile.invalid_tel")

              .form__field--input.md-form.field#verify_corporation.validate_field
                = f.label :corporation_id, t("corporation.index.name")
                = f.text_field :corporation_id, class: "input-field autocomplete form-control validate", id: "autocomplete-corporation", autocomplete: "organization", minlength: 3, required: true, style: "margin-bottom: 0.5rem;"
                .invalid-feedback
                  = t("profile.invalid_corporation")

              .form__field--input.md-form.field#verify_email.validate_field
                = f.label :email, t("users.index.email"), {"data-error" => "wrong", "data-success" => "right"}
                = f.email_field :email, autocomplete: "email", placeholder: 'example@mail.com', class: "form-control validate", style: "margin-bottom: 0.5rem;"
                .invalid-feedback
                  = t("profile.invalid_email")

              .form__field--input.md-form.field#verify_pass.validate_field
                = f.label :password, t("profile.password")
                = f.password_field :password, autocomplete: "new-password", class: "form-control", pattern: "(?=.*\d)(?=.*[a-z])(?=.*[A-Z]).{8,}"
                %span.fa.fa-fw.fa-eye-slash.field-icon.toggle-password{toggle: "#user_password"}
                - if @minimum_password_length
                  %small.form-text.text-muted
                    = t("profile.password_length")
                .invalid-feedback
                  = t("profile.invalid_pattern_password")

              .form__field--input.md-form.field#verify_pass_confirm.validate_field
                = f.label :password_confirmation, t("profile.password_confirmation")
                = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control"
                %span.fa.fa-fw.fa-eye-slash.field-icon.toggle-password{toggle: "#user_password_confirmation"}
                .invalid-feedback
                  = t("profile.mismatched_password")

              .check-div
                = f.check_box :accept_terms, class: "form-check-input validate_check", required: true, checked: true
                = f.label :accept_terms do
                  = link_to t('home.index.terms'), "https://ordenapp.co/terminos-y-condiciones", target: "_blank", title: t('home.index.terms')
                .invalid-feedback
                  = t("session.index.terms_service")

              .row.justify-content-center.flex-column.align-items-center
                = f.submit t("session.index.register"), class: "btn btn-outline-success btn-rounded btn-block form__submit my-4 not_continue", id: "register"
                %p
                  = t("session.index.member")
                  = link_to t("session.index.sign_in"), new_user_session_path, class: "form-link"

= render "home/whatsapp_button"